# ParqueRM — SQLite deployment example
# Copy this file to .env and fill in the real secrets.

# Application ports
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Frontend API URL (used at Docker build time)
VITE_API_URL=/api

# LAN URL injected into park_config.system_lan_url
SYSTEM_LAN_URL=http://parque.rm.local

# Database — SQLite
DB_TYPE=better-sqlite3
DB_PATH=/app/data/parquerm.db

# JWT secrets (min 16 chars)
JWT_SECRET=change-me-min-16-characters
JWT_REFRESH_SECRET=change-me-min-16-characters

# Optional: token expiration
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
