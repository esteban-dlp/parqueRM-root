{
  "appName": "ParqueRM",
  "version": "{{VERSION}}",
  "instanceId": "{{INSTANCE_ID}}",
  "canonicalHost": "parquerm.local",
  "localHostnames": ["parquerm.local", "parque.rm.local", "parque.rm.home.arpa"],
  "mdnsHostnames": ["parquerm.local", "parque.rm.local"],
  "serverIp": "{{SERVER_IP}}",
  "currentIpv4Addresses": ["{{SERVER_IP}}"],
  "recommendedUrl": "http://parquerm.local",
  "frontendUrl": "http://parquerm.local",
  "backendUrl": "http://parquerm.local/api",
  "swaggerUrl": "http://parquerm.local/api/docs",
  "fallbackUrls": ["http://parque.rm.local", "http://localhost", "http://127.0.0.1", "http://{{SERVER_IP}}"],
  "hostsConfigured": true,
  "installDir": "{{INSTALL_DIR}}",
  "dbType": "better-sqlite3",
  "dbPath": "{{DB_PATH}}",
  "discoveryPort": 47880,
  "legacyDnsServerPreserved": false,
  "routerSetupRequired": false,
  "primaryFlow": "lan-offline-local-name",
  "ports": {
    "frontend": {{FRONTEND_PORT}},
    "backend": {{BACKEND_PORT}},
    "mdns": 5353,
    "discovery": 47880
  }
}
